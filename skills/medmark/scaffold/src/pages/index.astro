---
import Base from '../layouts/Base.astro';
import site from '../site.json';
import {excerpt, formatDate, getPosts, groupByYear, postUrl, type Post} from '../lib/posts';

const posts: Post[] = await getPosts();
const years: [string, Post[]][] = groupByYear(posts);
---

<Base>
  <section class="intro">
    {site.author.avatar && <img class="intro__avatar" src={site.author.avatar} alt="" width="72" height="72" />}
    <div>
      <h1 class="intro__title">{site.tagline}</h1>
      {site.author.bio && <p class="intro__bio">{site.author.bio}</p>}
    </div>
  </section>

  {posts.length === 0 && (
    <p class="empty">
      No posts yet. Copy your medmark output into <code>content/posts/</code> and refresh.
    </p>
  )}

  {years.map(([year, yearPosts]) => (
    <section class="year">
      <h2 class="year__label">{year}</h2>
      <ul class="post-list">
        {yearPosts.map((post: Post) => (
          <li class="post-item">
            <a class="post-item__title" href={postUrl(post)}>{post.data.title ?? post.id}</a>
            <p class="post-item__meta">
              <time datetime={post.data.date?.toISOString()}>{formatDate(post.data.date)}</time>
              {post.data.readingTime && <> · {post.data.readingTime}</>}
              {post.data.draft && <> · <span class="badge">Draft</span></>}
            </p>
            {excerpt(post) && <p class="post-item__excerpt">{excerpt(post)}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
